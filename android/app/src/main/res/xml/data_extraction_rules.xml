<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no cubre la transferencia entre dispositivos.
     Se excluyen todos los dominios para que la sesión cifrada y los datos locales nunca salgan del dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
