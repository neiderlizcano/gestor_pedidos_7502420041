# Variables públicas: Vite las incrusta en el código compilado.
# Nunca colocar aquí claves privadas, tokens ni contraseñas.

# Navegador: base de la API. Vacía = mismo origen, atendido por el proxy de Vite
# en `npm run dev` y `npm run preview`.
VITE_API_BASE_URL=

# Android (Capacitor): URL HTTPS absoluta del backend, sin barra final.
# La app nativa no pasa por el proxy de Vite.
VITE_NATIVE_API_BASE_URL=https://gestor-pedidos-api.onrender.com

# Solo para el proxy de desarrollo de Vite; no llega al código de la app.
API_PROXY_TARGET=https://gestor-pedidos-api.onrender.com
