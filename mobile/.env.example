# Variables públicas: Vite las incrusta en el código compilado.
# Solo llegan a la app las cuatro VITE_* de este archivo (lista cerrada en src/bootstrap/public-env.ts);
# cualquier otra VITE_* se ignora. Nunca colocar aquí claves privadas, tokens ni contraseñas.
# Las URL deben ser un origen HTTPS: sin usuario, contraseña, ruta, parámetros ni fragmento.

# Navegador: base de la API. Vacía = mismo origen, atendido por el proxy de Vite
# en `npm run dev` y `npm run preview`.
VITE_API_BASE_URL=

# Android (Capacitor): origen HTTPS del backend. La app nativa no pasa por el proxy de Vite.
VITE_NATIVE_API_BASE_URL=https://gestor-pedidos-api.onrender.com

# Supabase Auth: descomentar y completar. Sin estas dos variables la app compila
# y la autenticación queda en MISCONFIGURED.
# Raíz HTTPS del proyecto, sin /auth/v1.
# VITE_SUPABASE_URL=https://<PROYECTO>.supabase.co
# Clave publicable (sb_publishable_...) o JWT heredado con role "anon". Es pública por diseño.
# El build se detiene si cualquier VITE_* contiene sb_secret_... o un JWT service_role.
# VITE_SUPABASE_PUBLISHABLE_KEY=<CLAVE_PUBLICABLE>

# Solo para el proxy de desarrollo de Vite; no llega al código de la app.
API_PROXY_TARGET=https://gestor-pedidos-api.onrender.com
